unique_name: Date
object_type: dimension
label: Date
type: time
level_attributes:
  - unique_name: Fiscal Year
    label: Fiscal Year
    dataset: DIM_RETAIL_CALENDAR
    name_column: FISCAL_YEAR_NAME
    key_columns:
      - FISCAL_YEAR
    sort_column: FISCAL_YEAR
    time_unit: Year
  - unique_name: Fiscal Quarter
    label: Fiscal Quarter
    dataset: DIM_RETAIL_CALENDAR
    name_column: FISCAL_QUARTER_NAME
    key_columns:
      - FISCAL_QUARTER_KEY
    sort_column: FISCAL_QUARTER_KEY
    time_unit: Quarter
  - unique_name: Fiscal Period
    label: Fiscal Period
    dataset: DIM_RETAIL_CALENDAR
    name_column: FISCAL_PERIOD_NAME
    key_columns:
      - FISCAL_PERIOD_KEY
    sort_column: FISCAL_PERIOD_KEY
    time_unit: Month
  - unique_name: Day
    label: Day
    dataset: DIM_RETAIL_CALENDAR
    name_column: DATE_NAME
    key_columns:
      - DATE_KEY
    sort_column: DATE_KEY
    time_unit: Day
  - unique_name: Day of Week
    label: Day of Week
    dataset: DIM_RETAIL_CALENDAR
    name_column: DAY_OF_WEEK_NAME
    key_columns:
      - DAY_OF_WEEK_NUM
    sort_column: DAY_OF_WEEK_NUM
hierarchies:
  - unique_name: Fiscal Calendar
    label: Fiscal Calendar
    levels:
      - unique_name: Fiscal Year
        level_attribute: Fiscal Year
      - unique_name: Fiscal Quarter
        level_attribute: Fiscal Quarter
      - unique_name: Fiscal Period
        level_attribute: Fiscal Period
      - unique_name: Day
        level_attribute: Day
